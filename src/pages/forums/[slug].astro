---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { BlogPostPage } from '../../views/BlogPostPage'
import { FORUM_THREADS, getForumThread } from '../../data/forums'
import { forumPath } from '../../data/blog-paths'
import { SEO, SITE_URL, type PageSeo } from '../../data/site'
export function getStaticPaths() {
  return FORUM_THREADS.map((post) => ({
    params: { slug: post.slug },
  }))
}

const { slug } = Astro.params
const post = getForumThread(slug!)

if (!post) {
  return Astro.redirect('/404')
}

const absoluteMedia = (path: string) => `${SITE_URL}${path}`
const ogImage = `/og/forums-${post.slug}.jpg`
const pageUrl = `${SITE_URL}${forumPath(post.slug)}`

const SEO_BY_SLUG: Partial<Record<string, PageSeo>> = {
  'features-list': SEO.features,
  'complete-setup': SEO.setup,
}

const seoOverride = SEO_BY_SLUG[post.slug]
const seo: PageSeo = seoOverride
  ? { ...seoOverride, image: ogImage, imageAlt: `${post.title} — Fortnite Spoofer forum thread` }
  : {
      title: post.metaTitle,
      description: post.metaDescription,
      path: forumPath(post.slug),
      ogType: 'article',
      image: ogImage,
      imageAlt: `${post.title} — Fortnite Spoofer forum thread`,
      robots: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
    }

const howToLd = post.howTo
  ? {
      '@type': 'HowTo',
      name: post.title,
      description: post.metaDescription,
      totalTime: `PT${post.readMinutes}M`,
      image: absoluteMedia(ogImage),
      step: post.sections.map((section, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: section.heading,
        text: section.body.join(' '),
        url: `${pageUrl}#${section.heading
          .replace(/^\d+\)\s*/, '')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '')}`,
      })),
    }
  : null

const jsonLdExtra = [
  {
    '@type': 'DiscussionForumPosting',
    '@id': `${pageUrl}#discussion`,
    headline: post.title,
    description: post.metaDescription,
    datePublished: post.date,
    dateModified: post.date,
    author: { '@id': `${SITE_URL}/#organization` },
    publisher: { '@id': `${SITE_URL}/#organization` },
    url: pageUrl,
    mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
    isPartOf: { '@id': `${SITE_URL}/forums#webpage` },
    image: {
      '@type': 'ImageObject',
      url: absoluteMedia(ogImage),
      width: 1200,
      height: 630,
      name: post.title,
      caption: post.metaDescription,
    },
    inLanguage: 'en',
    articleSection: post.tag,
  },
  ...(howToLd ? [howToLd] : []),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Forums', item: `${SITE_URL}/forums` },
      {
        '@type': 'ListItem',
        position: 3,
        name: post.title,
        item: pageUrl,
      },
    ],
  },
]
---

<BaseLayout seo={seo} jsonLdExtra={jsonLdExtra}>
  <BlogPostPage client:visible slug={post.slug} />
</BaseLayout>
