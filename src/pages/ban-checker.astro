---
import BaseLayout from '../layouts/BaseLayout.astro'
import { BanCheckerPage } from '../views/BanCheckerPage'
import { SEO, SITE_URL } from '../data/site'

const jsonLdExtra = [
  {
    '@type': 'WebApplication',
    name: 'HWID Ban Checker',
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'Windows',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    url: `${SITE_URL}/ban-checker`,
    description: SEO.banChecker.description,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Ban checker', item: `${SITE_URL}/ban-checker` },
    ],
  },
]
---

<BaseLayout seo={SEO.banChecker} jsonLdExtra={jsonLdExtra}>
  <BanCheckerPage client:load />
</BaseLayout>
