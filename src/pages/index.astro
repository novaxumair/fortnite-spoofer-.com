---
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroBannerVideo from '../components/HeroBannerVideo.astro'
import { HomePage } from '../views/HomePage'
import { SEO } from '../data/site'
import { productCoreJsonLd } from '../lib/seo'
---

<BaseLayout
  seo={SEO.home}
  jsonLdExtra={[productCoreJsonLd()]}
>
  <div class="overflow-x-hidden text-white">
    <section
      id="home"
      class="hero-panel hero-panel--home relative flex flex-col overflow-hidden"
    >
      <HeroBannerVideo />
      <HomePage client:load part="hero" />
    </section>
    <HomePage client:load part="main" />
  </div>
</BaseLayout>
