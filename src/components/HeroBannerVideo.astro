---
/** Native hero video — must stay opaque (no VP9 alpha) for Chrome background playback. */
const webm = '/videos/hero.webm'
const mp4 = '/videos/hero.mp4'
const label = 'Fortnite spoofer hero preview on Windows PC'
---

<div
  class="hero-video-wrap pointer-events-none absolute inset-0 z-0 overflow-hidden select-none"
  data-hero-video
  aria-hidden="true"
>
  <video
    class="hero-video-bg hero-video-bg--home absolute z-[1]"
    autoplay
    muted
    loop
    playsinline
    webkit-playsinline="true"
    preload="auto"
    aria-label={label}
  >
    <source src={webm} type="video/webm" />
    <source src={mp4} type="video/mp4" />
  </video>
  <div class="hero-video-tint pointer-events-none absolute inset-0 z-[2]" aria-hidden="true"></div>
  <div class="hero-video-tint-glow pointer-events-none absolute inset-0 z-[2]" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 z-[3] h-40 bg-gradient-to-t from-z-bg via-z-bg/80 to-transparent"
    aria-hidden="true"
  ></div>
</div>
